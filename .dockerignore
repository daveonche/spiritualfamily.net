# Version control
.git/
.gitignore

# AI assistant files (dev-only, reinstall from source repo)
.aider*
.agent/
agent.sh

# IDE and editor configurations
.idea/
.vscode/
*.code-workspace

# Node dependencies (if not needed at runtime)
**/node_modules/
**/npm-debug.log

# Documentation and tests
**/*.md
docs/
**/tests/
phpunit.xml*

# Composer specific
composer.phar

# Dependencies: the tracked src/vendor/ tree is the pin — the app image
# bakes it via COPY src/ (docker/app/Dockerfile: "No composer step here"),
# so it must stay in the build context. Restores the Story S1.6 rule
# (S1.9 Step 8 fix): the interim composer-install exclusion was never
# implemented in the Dockerfile and left the baked image without vendor/.

# Elgg specific
**/cache/
**/caches/
**/engine/settings.php
# The baked vendor/ tree is the pin and must enter the image verbatim:
# re-include it in full — the broad patterns above also match vendor
# content (**/cache/ strips the psr/cache package directory, a package
# name rather than a runtime cache, whose missing CacheItemPoolInterface
# fatals every Elgg 3 boot; S1.9 Step 8)
!src/vendor/**

# Environment variables and secrets
.env

# CI/CD configs (not needed in the image)
.travis.yml
.scrutinizer.yml
.readthedocs.yml
.github/

# OS specific files
Thumbs.db
Desktop.ini

# Misc
phpcbf-fixed.diff
startup.sh

# Story S1.6: local log output never enters the repository-root build
# context
.log
