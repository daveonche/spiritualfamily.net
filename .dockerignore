# Version control
.git/
.gitignore

# AI assistant files (dev-only, reinstall from source repo)
.aider*
.agent/
agent.sh

# IDE and editor configurations
.idea/
.vscode/
*.code-workspace

# Node dependencies (if not needed at runtime)
**/node_modules/
**/npm-debug.log

# Documentation and tests
**/*.md
docs/
**/tests/
phpunit.xml*

# Composer specific
composer.phar

# Dependencies (Story S1.9: Elgg 3's composer-install model — vendor/ is
# untracked and installed from the committed composer.lock during the app
# image build; a stale on-disk tree must not enter the build context and
# be COPY-ed over the lock install. Supersedes the Story S1.6 rule that
# kept src/vendor in the context while it was tracked in git)
src/vendor/

# Elgg specific
**/cache/
**/caches/
**/engine/settings.php

# Environment variables and secrets
.env

# CI/CD configs (not needed in the image)
.travis.yml
.scrutinizer.yml
.readthedocs.yml
.github/

# OS specific files
Thumbs.db
Desktop.ini

# Misc
phpcbf-fixed.diff
startup.sh

# Story S1.6: local log output never enters the repository-root build
# context
.log
