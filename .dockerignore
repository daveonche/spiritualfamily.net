# Version control
.git/
.gitignore

# AI assistant files (dev-only, reinstall from source repo)
.aider*
.agent/
agent.sh

# IDE and editor configurations
.idea/
.vscode/
*.code-workspace

# Node dependencies (if not needed at runtime)
**/node_modules/
**/npm-debug.log

# Documentation and tests
**/*.md
docs/
**/tests/
phpunit.xml*

# Composer specific (Story S1.6: src/vendor is tracked in git and is
# baked into the app image by COPY src/ — it must not be excluded from
# the repository-root build context)
composer.phar

# Elgg specific
**/cache/
**/caches/
**/engine/settings.php

# Environment variables and secrets
.env

# CI/CD configs (not needed in the image)
.travis.yml
.scrutinizer.yml
.readthedocs.yml
.github/

# OS specific files
Thumbs.db
Desktop.ini

# Misc
phpcbf-fixed.diff
startup.sh

# Story S1.6: local log output never enters the repository-root build
# context
.log
