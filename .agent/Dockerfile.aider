# syntax=docker/dockerfile:1
#
# Build context for this file is the .agent directory itself (managed by
# launcher.py, which auto-creates a minimal .dockerignore). This file
# intentionally contains NO COPY instructions:
#   - Project source code is provided at runtime via the same-path bind mount
#     of the project root (see run_container in launcher.py).
#   - `docker` / `docker compose` executed inside the container talk to the
#     host daemon through the mounted /var/run/docker.sock, so compose stacks
#     are siblings of this container and all paths resolve on the host.
#
# Base image pinned by tag + manifest-list digest for reproducible builds
# (verified against the Docker Hub tags API; recorded in docs/tech_stack.md
# under "Verified Image Pins"). To upgrade: inspect the new tag's digest
# with `docker buildx imagetools inspect` or the Docker Hub tags API, then
# update this line and docs/tech_stack.md together and run ./.agent/start.sh.
FROM paulgauthier/aider-full:v0.86.2@sha256:ba4d51b3c846b89d0f261f88dd712b9ce62968d3844c73fe2b3353ae65b11ea4

USER root

# ---- Environment flags BEFORE any install layer ----------------------------
# PUPPETEER_SKIP_DOWNLOAD prevents mermaid-cli's puppeteer dependency from
# downloading a ~170MB Chrome build that would never be used (puppeteer is
# pointed at the system chromium below). HF_HOME bakes the embedding model
# into a world-readable path so the runtime user loads it offline instead of
# re-downloading ~100MB on first run.
#
# Optional: uncomment HF_HUB_OFFLINE to skip Hugging Face update checks at
# startup. Safe once the model below is baked in; blocks runtime model swaps.
# ENV HF_HUB_OFFLINE=1
ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    HF_HOME=/opt/hf-cache \
    DEBIAN_FRONTEND=noninteractive

# ---- Layer A: system dependencies and Chromium ------------------------------
# Biggest and most stable payload: keep it first so its cache survives all
# later layer churn. alsa-utils is kept for ALSA (/dev/snd) audio support.
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        libpulse0 \
        alsa-utils \
        chromium \
        cmark-gfm \
        openssh-client

# ---- Layer B: pre-bake the Python embedding model ---------------------------
# Expensive but rarely changing: placed before anything volatile so it stays
# cached even when the npm layers below are rebuilt. chmod a+rX makes the
# cache readable by any runtime user (host uid via docker run --user).
RUN python3 -c "from sentence_transformers import SentenceTransformer; \
    SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')" && \
    chmod -R a+rX /opt/hf-cache

# ---- Layer C: Docker CLI + compose plugin + Node.js -------------------------
# docker-ce-cli, docker-buildx-plugin, and docker-compose-plugin are required
# so aider can run `docker` / `docker compose` (including `docker compose
# build`, which delegates to buildx) inside the container for debugging
# against the host daemon (socket mounted at runtime). Both third-party repos
# are added first, then a single apt-get update + install sweep.
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    chmod a+r /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        docker-ce-cli \
        docker-buildx-plugin \
        docker-compose-plugin \
        nodejs

# ---- Layer D: global npm utilities (most volatile layer) --------------------
# npm cache mount avoids re-downloading tarballs when this layer changes.
# Exact-pinned (no caret): a floating ^11 would auto-pull any future 11.x —
# including a compromised release — on the next rebuild; upgrades are manual.
# NOTE: the npm "shellcheck" package is intentionally NOT used. It is only a
# JS wrapper that downloads the real binary on FIRST RUN into root-owned
# /usr/lib/node_modules, which fails with EACCES for the non-root runtime
# user. The official static binary is baked in below instead.
RUN --mount=type=cache,target=/root/.npm \
    npm install -g --no-audit --no-fund \
        @mermaid-js/mermaid-cli@11.17.0

# ---- Layer D2: ShellCheck (real static binary, baked at build time) ---------
# Version-pinned, offline at runtime, executable by every user. TARGETARCH is
# auto-provided by BuildKit (amd64/arm64/arm). The xz check is a no-op when
# the base image already ships it. Alternative: `apt-get install shellcheck`
# gives Debian bookworm's v0.8.0 if you prefer zero GitHub traffic.
# Version-pinned and checksum-gated: the tarball's SHA256 is pinned per arch
# and verified BEFORE extraction, so a replaced release asset fails the build
# instead of installing as root. To upgrade: bump SHELLCHECK_VERSION and all
# three SHA256 ARGs together (sha256sum each release .tar.xz).
ARG TARGETARCH
ARG SHELLCHECK_VERSION=v0.10.0
ARG SHELLCHECK_SHA256_X86_64=6c881ab0698e4e6ea235245f22832860544f17ba386442fe7e9d629f8cbedf87
ARG SHELLCHECK_SHA256_AARCH64=324a7e89de8fa2aed0d0c28f3dab59cf84c6d74264022c00c22af665ed1a09bb
ARG SHELLCHECK_SHA256_ARMV6HF=1c89cb51e1412b580d7ba8aac240251ffb0b829788f83d2daa4a82da42d275e4
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    { command -v xz >/dev/null 2>&1 || { apt-get update && apt-get install -y --no-install-recommends xz-utils; }; } && \
    case "${TARGETARCH}" in \
        arm64) SC_ARCH=aarch64 ; SC_SHA256="${SHELLCHECK_SHA256_AARCH64}" ;; \
        arm) SC_ARCH=armv6hf ; SC_SHA256="${SHELLCHECK_SHA256_ARMV6HF}" ;; \
        *) SC_ARCH=x86_64 ; SC_SHA256="${SHELLCHECK_SHA256_X86_64}" ;; \
    esac && \
    curl -fsSL "https://github.com/koalaman/shellcheck/releases/download/${SHELLCHECK_VERSION}/shellcheck-${SHELLCHECK_VERSION}.linux.${SC_ARCH}.tar.xz" -o /tmp/shellcheck.tar.xz && \
    echo "${SC_SHA256}  /tmp/shellcheck.tar.xz" | sha256sum -c - && \
    tar -xJf /tmp/shellcheck.tar.xz -C /tmp && \
    install -m 0755 "/tmp/shellcheck-${SHELLCHECK_VERSION}/shellcheck" /usr/local/bin/shellcheck && \
    rm -rf "/tmp/shellcheck-${SHELLCHECK_VERSION}" /tmp/shellcheck.tar.xz

# ---- Layer D2b: actionlint (GitHub Actions workflow linter) -----------------
# Version-pinned and checksum-gated, same pattern as ShellCheck above. To
# upgrade: bump ACTIONLINT_VERSION and all three SHA256 ARGs together (from
# the release's checksums.txt, e.g. actionlint_1.7.12_checksums.txt).
ARG ACTIONLINT_VERSION=1.7.12
ARG ACTIONLINT_SHA256_AMD64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ARG ACTIONLINT_SHA256_ARM64=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6
ARG ACTIONLINT_SHA256_ARMV6=ae4a0a5227578e66f5d00ee02788d5c64fdae1fa6484ab88ceaeee9359c28fa4
RUN case "${TARGETARCH}" in \
        arm64) AL_ARCH=arm64 ; AL_SHA256="${ACTIONLINT_SHA256_ARM64}" ;; \
        arm) AL_ARCH=armv6 ; AL_SHA256="${ACTIONLINT_SHA256_ARMV6}" ;; \
        *) AL_ARCH=amd64 ; AL_SHA256="${ACTIONLINT_SHA256_AMD64}" ;; \
    esac && \
    curl -fsSL "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_${AL_ARCH}.tar.gz" -o /tmp/actionlint.tar.gz && \
    echo "${AL_SHA256}  /tmp/actionlint.tar.gz" | sha256sum -c - && \
    mkdir -p /tmp/actionlint && \
    tar -xzf /tmp/actionlint.tar.gz -C /tmp/actionlint && \
    install -m 0755 /tmp/actionlint/actionlint /usr/local/bin/actionlint && \
    rm -rf /tmp/actionlint /tmp/actionlint.tar.gz

# ---- Layer D3: pytest testing dependency (pip) ------------------------------
# pytest pinned to match .agent/pyproject.toml (8.3.5) so the container's
# /venv interpreter can run the project's test suite exactly like the host.
# The pip cache mount avoids re-downloading wheels on rebuilds.
RUN --mount=type=cache,target=/root/.cache/pip \
    /venv/bin/python3 -m pip install pytest==8.3.5

# ---- Layer E: runtime configuration ----------------------------------------
# Sticky bit (1777) instead of 777: /home stays writable as a shared scratch
# HOME (the launcher sets HOME=/home and mounts host caches into it) without
# allowing file ownership tampering.
RUN mkdir -p /home && chmod 1777 /home && \
    echo '{"args": ["--no-sandbox"]}' > /home/puppeteer-config.json

USER aider
