# .aiderignore — gitignore-style exclusions applied by aider on top of
# .gitignore. Unlike .gitignore, these patterns also apply to files that
# are already tracked in git, keeping vendored third-party code out of
# aider's repo map and edit scope.

# Composer vendor trees (includes Elgg core at src/vendor/elgg/elgg).
# Ignore directory contents, then negate specific paths so they can
# still be added to the chat via /read-only.
src/vendor/*
!src/vendor/elgg/
src/vendor/elgg/*
!src/vendor/elgg/elgg/
src/vendor/elgg/elgg/*
!src/vendor/elgg/elgg/composer.json
!src/vendor/elgg/elgg/version.php
# Personal plugins: only src/mod/ directories with the "sfn_" prefix are
# visible to aider; all other (third-party) plugins are excluded from the
# repo map and edit scope. New sfn_* plugins are picked up automatically.
src/mod/*
!src/mod/sfn_*/

# Dependency/asset dirs inside the visible personal plugins
src/mod/*/vendor/
src/mod/*/vendors/
src/mod/*/node_modules/
src/node_modules/

# To expose more Elgg core files/dirs to aider, add negation lines, e.g.:
# !src/vendor/elgg/elgg/engine/
