# ┌───────────── minute (0-59)
# │ ┌───────────── hour (0-23)
# │ │ ┌───────────── day of month (1-31)
# │ │ │ ┌───────────── month (1-12)
# │ │ │ │ ┌───────────── day of week (0-6) (Sunday to Saturday)
# │ │ │ │ │
# * * * * * command
# Elgg cron jobs
#
# Schedule set (Story S1.7 Step 2) — every recurring interval supported by
# the pinned Elgg core, at its defined frequency:
#   minute      * * * * *     every minute
#   fiveminute  */5 * * * *   every 5 minutes
#   fifteenmin  */15 * * * *  every 15 minutes
#   halfhour    */30 * * * *  every 30 minutes
#   hourly      0 * * * *     hourly, on the hour
#   daily       0 0 * * *     daily at midnight
#   weekly      0 0 * * 0     weekly, Sunday midnight
#   monthly     0 0 1 * *     monthly, 1st at midnight
#   yearly      0 0 1 1 *     yearly, Jan 1 at midnight
#
# Per-upgrade duty (re-verify at every core upgrade in the sequence):
# re-derive the supported intervals from the vendored core itself — the
# period => interval map in _elgg_cron_run()
# (src/vendor/elgg/elgg/engine/lib/cron.php; 2.3.17 has no
# elgg_get_cron_periods(), re-point at the new core's periods API when
# one appears) — adjust this crontab and the pinned list in
# src/tests/CronSanctionedEntryPointTest.php to match, then re-run the
# guard suite — src/tests/CronScheduleCoverageTest.php cross-checks the
# crontab and the pinned list against the core itself. The core's
# deprecated 'reboot' period stays unscheduled: it is not a recurring
# interval and has no cron schedule.
#
# Scheduled-task output log (Story S1.7 Step 5): every interval line
# appends its output to /var/log/cron/app-cron.log (the fs-cronlog
# volume), and the daily rotation entry below copy-truncates that log
# into gzip archives, pruning archives older than the retention window
# — the duty of the dropped logrotate plugin (REQ-FR-PU-7). Guarded by
# src/tests/CronLogRotationTest.php.
* * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/minute?__elgg_mac={{MINUTE_PLACEHOLDER}} >> /var/log/cron/app-cron.log 2>&1
*/5 * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/fiveminute?__elgg_mac={{FIVEMINUTE_PLACEHOLDER}} >> /var/log/cron/app-cron.log 2>&1
*/15 * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/fifteenmin?__elgg_mac={{FIFTEENMIN_PLACEHOLDER}} >> /var/log/cron/app-cron.log 2>&1
*/30 * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/halfhour?__elgg_mac={{HALFHOUR_PLACEHOLDER}} >> /var/log/cron/app-cron.log 2>&1
0 * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/hourly?__elgg_mac={{HOURLY_PLACEHOLDER}} >> /var/log/cron/app-cron.log 2>&1
0 0 * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/daily?__elgg_mac={{DAILY_PLACEHOLDER}} >> /var/log/cron/app-cron.log 2>&1
0 0 * * 0 wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/weekly?__elgg_mac={{WEEKLY_PLACEHOLDER}} >> /var/log/cron/app-cron.log 2>&1
0 0 1 * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/monthly?__elgg_mac={{MONTHLY_PLACEHOLDER}} >> /var/log/cron/app-cron.log 2>&1
0 0 1 1 * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/yearly?__elgg_mac={{YEARLY_PLACEHOLDER}} >> /var/log/cron/app-cron.log 2>&1

# Daily rotation of the scheduled-task output log (Story S1.7 Step 5):
# runs after the midnight Elgg jobs so their output lands in the
# archived day; the script's own confirmation output appends to the
# same dedicated log (the image ships no sendmail, so unredirected
# job output would be lost); guarded by src/tests/CronLogRotationTest.php
30 0 * * * /usr/local/bin/rotate-cron-log.sh >> /var/log/cron/app-cron.log 2>&1

# An empty line is required at the end
