DATA_ROOT=/var/www/dataroot
WWW_ROOT=/var/www/html

MYSQL_DATABASE=mysqldb
MYSQL_USER=user
MYSQL_PASSWORD=pass
MYSQL_RANDOM_ROOT_PASSWORD="yes"

# Service name of the mysql container
MYSQL_HOST=dbm

MYSQL_CONTAINER_NAME=spiritualfamily_dbm
MYSQL_PORT=3306

# In production (tested on Namecheap Magnetar VPS), 
# replace with https://spiritualfamily.online/
ELGG_WWWROOT=http://v2.sfnapp.local:3010/

ELGG_TIMEZONE=UTC
ELGG_DATAROOT=/var/www/dataroot
ELGG_DB_PREFIX=sfn_

# Docker Compose automatically reads this and prefixes everything (containers, networks, and volumes) uniformly
# COMPOSE_PROJECT_NAME=sfn

APP_CONTAINER_NAME=spiritualfamily_app
APP_HOST=v2.sfnapp.local
APP_HOST_PORT=3010

# Change to 'production' in production environment
APP_ENV=development

