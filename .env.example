DATA_ROOT=/var/www/dataroot
WWW_ROOT=/var/www/html

MYSQL_DATABASE=mysqldb
MYSQL_USER=user
MYSQL_PASSWORD=pass
MYSQL_RANDOM_ROOT_PASSWORD="yes"
MYSQL_HOST=dbm                                      # Service name of the mysql container
MYSQL_PORT=3306

ELGG_TIMEZONE=UTC
ELGG_WWWROOT=http://v2.tleapp.local:3000/                # In production (tested on godaddy managed vps), replace with https://the-leadership-experience.com/  
ELGG_DATAROOT=/var/www/dataroot
ELGG_DB_PREFIX=prefix_
APP_HOST=v2.tleapp.local
APP_HOST_PORT=3000
APP_ENV=development                                # Change to 'production' in production environment

VENDOR_PROFILE_PLUGIN=./api/vendor/elgg/elgg/mod/profile
MOD_PROFILE_PLUGIN=/var/www/html/mod/profile
VENDOR_CKEDITOR_PLUGIN=./api/vendor/elgg/elgg/mod/ckeditor
MOD_CKEDITOR_PLUGIN=/var/www/html/mod/ckeditor
VENDOR_DEVELOPERS_PLUGIN=./api/vendor/elgg/elgg/mod/developers
MOD_DEVELOPERS_PLUGIN=/var/www/html/mod/developers
VENDOR_EXTERNALPAGES_PLUGIN=./api/vendor/elgg/elgg/mod/externalpages
MOD_EXTERNALPAGES_PLUGIN=/var/www/html/mod/externalpages
VENDOR_MESSAGES_PLUGIN=./api/vendor/elgg/elgg/mod/messages
MOD_MESSAGES_PLUGIN=/var/www/html/mod/messages
VENDOR_SEARCH_PLUGIN=./api/vendor/elgg/elgg/mod/search
MOD_SEARCH_PLUGIN=/var/www/html/mod/search
VENDOR_SITE_NOTIFICATIONS_PLUGIN=./api/vendor/elgg/elgg/mod/site_notifications
MOD_SITE_NOTIFICATIONS_PLUGIN=/var/www/html/mod/site_notifications
VENDOR_SYSTEM_LOG_PLUGIN=./api/vendor/elgg/elgg/mod/system_log
MOD_SYSTEM_LOG_PLUGIN=/var/www/html/mod/system_log
VENDOR_WEB_SERVICES_PLUGIN=./api/vendor/elgg/elgg/mod/web_services
MOD_WEB_SERVICES_PLUGIN=/var/www/html/mod/web_services

# SMTP setup for mailhog in development
EMAILER_TRANSPORT='smtp'
SMTP_NAME='mailhog'                                 # VPS Mail HELO name
SMTP_HOST='mailhog'                                 # VPS Hostname
SMTP_USERNAME=''                                    # info@example.com
SMTP_PASSWORD=''                                    # use the email account password
SMTP_SSL=''                                         # OPTIONAL (tls or ssl)
SMTP_PORT=1025                                      # OPTIONAL (Non-SSL default 25, SSL default 465, TLS default 587)

PMA_HOST_PORT=3001
PMA_PORT=3306
PMA_HOST=dbm

# docker-compose.dev.yml variables
MAILHOG_HOST_PORT=3002
MAILHOG_SMTP_PORT=1025
# MH_STORAGE=maildir                                  # switch from in-memory to maildir on disk
# MH_MAILDIR_PATH=/mailhog/data                       # where on the container to store the maildir

# RATE_API_KEY=''                                   # Get API from https://app.exchangerate-api.com/

# 127.0.0.1 v2.tleapp.local                 # Open C:\Windows\System32\drivers\etc\hosts with administrative priviledge and add for local development.