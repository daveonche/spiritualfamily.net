# ------------------------------------------------------------------
# Environment template — Story S1.2 Step 6
#
# Copy to .env and fill in real values locally:
#   cp .env.example .env
#
# .env is git-ignored; real secrets never enter the repository.
# Every variable required by compose.yml (interpolation + env_file),
# src/elgg-config/settings.php (getenv), and the pma service is listed
# here, so a fresh environment needs no undocumented values.
# Replace every "changeme" placeholder before first use.
# ------------------------------------------------------------------

# --- Compose interpolation (compose.yml) ---

# PHP runtime version for the app image build arg and image tag
# (default recorded in docs/baseline/baseline.md)
PHP_VERSION=7.4

# Optional: pin the Compose project name — it uniformly prefixes containers,
# networks, and volumes (an isolated run automatically gets its own fresh
# volumes)
# COMPOSE_PROJECT_NAME=sfn

# Container names
APP_CONTAINER_NAME=changeme_app
MYSQL_CONTAINER_NAME=changeme_dbm
PMA_CONTAINER_NAME=changeme_pma
CRON_CONTAINER_NAME=changeme_cron

# Site host name: mapped to host-gateway inside the app container and
# passed to the cron service as the token target host
APP_HOST=changeme.example.test

# Published ports (host side)
APP_HOST_PORT=3000
PMA_HOST_PORT=3001

# Elgg data directory inside the app container — read via getenv in
# settings.php; must stay identical to the literal fs-dataroot mount
# target in compose.yml
WWW_DATA=/var/www/dataroot

# Elgg cache directory inside the app container — read via getenv in
# settings.php; must stay identical to the literal fs-cacheroot mount
# target in compose.yml
WWW_CACHE=/var/www/cacheroot

# Cron token placeholders replaced into the crontab spool file
APP_CRON_MINUTE=changeme
APP_CRON_FIVEMINUTE=changeme
APP_CRON_FIFTEENMIN=changeme
APP_CRON_HALFHOUR=changeme
APP_CRON_HOURLY=changeme
APP_CRON_DAILY=changeme
APP_CRON_WEEKLY=changeme
APP_CRON_MONTHLY=changeme
APP_CRON_YEARLY=changeme

# --- Outgoing mail (app service; PHP mail() → msmtp relay, docker/app/php/mail.ini) ---

# SMTP relay host/port for outgoing mail. Dev default: the Docker Desktop
# MailHog extension (SMTP 1025, web UI 8025). Production: real SMTP via
# Coolify environment settings (Story S1.6).
MAIL_SMTP_HOST=host.docker.internal
MAIL_SMTP_PORT=1025

# Authenticated submission (Story S1.6 Step 5): MAIL_SMTP_AUTH=on switches
# the msmtp-sendmail wrapper to authenticated STARTTLS submission using
# MAIL_SMTP_USER/MAIL_SMTP_PASSWORD. Leave AUTH empty in development —
# the wrapper then keeps the plaintext MailHog behaviour and the
# credential placeholders stay inert. Production sets all three via
# Coolify environment settings; the password is a secret, never committed.
MAIL_SMTP_AUTH=
MAIL_SMTP_USER=changeme
MAIL_SMTP_PASSWORD=changeme

# --- Database (dbm service via env_file; shared with the app) ---

# Root password of the MariaDB server itself
MYSQL_ROOT_PASSWORD=changeme

# Application database name, user, and password — one definition serves
# both the dbm entrypoint and the app's settings.php
MYSQL_DATABASE=changeme
MYSQL_USER=changeme
MYSQL_PASSWORD=changeme

# --- App / Elgg (src/elgg-config/settings.php via env_file) ---

# Database host as seen from the app container: the dbm service name.
# (Inside the dbm container itself, compose.yml overrides MYSQL_HOST to
# localhost so its healthcheck probe stays on the unix socket.)
MYSQL_HOST=dbm

# Prefix prepended to every Elgg table name
ELGG_DB_PREFIX=changeme_

# PHP timezone used by date_default_timezone_set() in settings.php
ELGG_TIMEZONE=UTC

# --- phpMyAdmin (pma service via env_file) ---

# Database host as seen from the pma container: the dbm service name
PMA_HOST=dbm

# --- Local development hosts entry ---
# Map your APP_HOST hostname to 127.0.0.1 in your OS hosts file so the site
# URL resolves locally, e.g. with APP_HOST=v2.sfnapp.local:
#   127.0.0.1 v2.sfnapp.local
# (Windows: edit C:\Windows\System32\drivers\etc\hosts with administrative
# privilege)
