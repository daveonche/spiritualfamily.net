# SMTP setup for mailhog in development
EMAILER_TRANSPORT='smtp'
SMTP_NAME='mailhog'                                 # VPS Mail HELO name
SMTP_HOST='mailhog'                                 # VPS Hostname
SMTP_USERNAME=''                                    # info@example.com
SMTP_PASSWORD=''                                    # use the email account password
SMTP_SSL=''                                         # OPTIONAL (tls or ssl)
SMTP_PORT=1025                                      # OPTIONAL (Non-SSL default 25, SSL default 465, TLS default 587)

PMA_CONTAINER_NAME=spiritualfamily_pma
PMA_HOST_PORT=3011
PMA_PORT=3306
PMA_HOST=dbm

# docker-compose.dev.yml variables
MAILHOG_CONTAINER_NAME=spiritualfamily_mailhog
MAILHOG_HOST_PORT=3012
MAILHOG_SMTP_PORT=1025
# switch from in-memory to maildir on disk
# MH_STORAGE=maildir
# where on the container to store the maildir                        
# MH_MAILDIR_PATH=/mailhog/data

# Get API from https://app.exchangerate-api.com/
# RATE_API_KEY=''

# Open C:\Windows\System32\drivers\etc\hosts with administrative priviledge and add this to the file for local development.
# 127.0.0.1 v2.sfnapp.local

# AIDER (AI Assistant)
# Generate your own API key at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-...

# Generate your own API key at https://platform.openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...
AIDER_OPENROUTER_API_KEY=sk-or-v1-...

# Generate your own API key at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...
AIDER_HF_TOKEN=hf_...

# Generate your own API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
AIDER_GEMINI_API_KEY=AIzaSy...

LITELLM_NUM_RETRIES=5