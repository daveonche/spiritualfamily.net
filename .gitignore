# ignore files and folders
/api/cache
# /api/settings.php

/api/mod/*
/api/composer.phar
/api/cache
/api/caches/
/api/phpunit.xml
# /src

# ignore IDE/hidden/testing/OS cache files
.log
.env
*.code-workspace
/api/.*
/api/*~
/api/nbproject
/api/nb-configuration.xml
/api/Session.vim
/api/*.tmproj
/api/*.tmproject
/api/tmtags
/api/Thumbs.db
/api/Desktop.ini
/api/npm-debug.log
/api/phpcbf-fixed.diff
/api/node_modules
/api/vendor

# Codio.com
/api/startup.sh

# don't ignore important files
!.env.example

!/api/mod/ckeditor/
!/api/mod/developers/
!/api/mod/embed/
!/api/mod/externalpages/
