# ------------------------------------------------------------------
# caches / build output
# ------------------------------------------------------------------
/src/cache/
/src/caches/
/src/phpcbf-fixed.diff
/src/composer.phar
*.phar

# ------------------------------------------------------------------
# environment / secrets
# ------------------------------------------------------------------
.env
!.env.example

# ------------------------------------------------------------------
# logs / temp files
# ------------------------------------------------------------------
*.log
*.code-workspace

# repo-local scratch space for large temporary artifacts (e.g. production
# dump restores); git-ignored so they are never committed
/tmp/

# ------------------------------------------------------------------
# IDE / editor
# ------------------------------------------------------------------
.idea/
.vscode/

# ------------------------------------------------------------------
# OS cruft (matches at any depth)
# ------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# Windows NTFS zone streams (downloaded-file metadata) & shortcuts
*:Zone.Identifier
*.lnk

# ------------------------------------------------------------------
# project-local dev cruft under /src
# ------------------------------------------------------------------
/src/nbproject/
/src/nb-configuration.xml
/src/Session.vim
/src/*~
/src/*.tmproj
/src/*.tmproject
/src/tmtags
/src/npm-debug.log*
/src/node_modules/
/src/vendor/
/src/startup.sh

# ------------------------------------------------------------------
# AI assistant files
# ------------------------------------------------------------------
# .aider* also covers the unguessably named per-checkout aiderignore copy
# (stamped from docs/aiderignore.template) — never negate a name here.
.aider*

# agent workflow / orchestration context (dev-only, install from source repo)
.agent/
agent.sh
.githooks/

# ------------------------------------------------------------------
# plugins (tracked intentionally — add exclusions here if needed)
# ------------------------------------------------------------------
# nested dependency trees inside plugins
/src/mod/*/vendor/
/src/mod/*/vendors/
/src/mod/*/node_modules/

# composer-managed plugin package (installed from composer.lock; the legacy
# tracked copy was removed in Story S1.4 Step 4)
/src/mod/data_views/

# settings.php is generated by the installer but tracked on purpose
# /src/settings.php
