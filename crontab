# * * * * * command
# Elgg cron jobs
#
# Schedule set (Story S1.7 Step 2) — every recurring interval supported by
# the pinned Elgg core, at its defined frequency:
#   minute      * * * * *     every minute
#   fiveminute  */5 * * * *   every 5 minutes
#   fifteenmin  */15 * * * *  every 15 minutes
#   halfhour    */30 * * * *  every 30 minutes
#   hourly      0 * * * *     hourly, on the hour
#   daily       0 0 * * *     daily at midnight
#   weekly      0 0 * * 0     weekly, Sunday midnight
#   monthly     0 0 1 * *     monthly, 1st at midnight
#   yearly      0 0 1 1 *     yearly, Jan 1 at midnight
#
# Per-upgrade duty (re-verify at every core upgrade in the sequence):
# re-derive the supported intervals from the new core's
# elgg_get_cron_periods() (src/vendor/elgg/elgg/engine/lib/cron.php),
# adjust this crontab and the pinned list in
# src/tests/CronSanctionedEntryPointTest.php to match, then re-run the
# guard suite — src/tests/CronScheduleCoverageTest.php cross-checks the
# crontab and the pinned list against the core itself.
* * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/minute?__elgg_mac={{MINUTE_PLACEHOLDER}}
*/5 * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/fiveminute?__elgg_mac={{FIVEMINUTE_PLACEHOLDER}}
*/15 * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/fifteenmin?__elgg_mac={{FIFTEENMIN_PLACEHOLDER}}
*/30 * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/halfhour?__elgg_mac={{HALFHOUR_PLACEHOLDER}}
0 * * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/hourly?__elgg_mac={{HOURLY_PLACEHOLDER}}
0 0 * * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/daily?__elgg_mac={{DAILY_PLACEHOLDER}}
0 0 * * 0 wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/weekly?__elgg_mac={{WEEKLY_PLACEHOLDER}}
0 0 1 * * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/monthly?__elgg_mac={{MONTHLY_PLACEHOLDER}}
0 0 1 1 * wget -qO- --header "Host: {{HOST_PLACEHOLDER}}" http://app:80/cron/yearly?__elgg_mac={{YEARLY_PLACEHOLDER}}

