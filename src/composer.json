{
	"name": "elgg/starter-project",
	"description": "This is a quickstart skeleton for building a site based on Elgg 3.x.",
	"license": "MIT",
	"prefer-stable": true,
	"minimum-stability": "dev",
	"require": {
		"elgg/elgg": "3.3.25",
		"roave/security-advisories": "dev-master#69ddaead6caa68f4f6190e2ee732f103326e78ba"
	},
	"require-dev": {
		"phpunit/phpunit": "9.6.38"
	},
	"replace": {
		"elgg/login_as": "2.1.0"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		}
	],
	"scripts": {
		"post-install-cmd": "\\Elgg\\Composer\\PostInstall::execute",
		"post-package-update": "\\Elgg\\Composer\\PostUpdate::execute",
		"test": "phpunit"
	},
	"config": {
		"process-timeout": 0,
		"platform": {
			"php": "7.4.27"
		},
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
